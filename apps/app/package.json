{
  "name": "@moneo/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts --auto && next dev --port 3031",
    "build": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts --auto && next build",
    "start": "next start --port 3031",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx --test --test-force-exit \"lib/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate && npm run db:migrate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:pull-prod": "node --import tsx scripts/pull-prod.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@clerk/nextjs": "^7.9.13",
    "@daypicker/react": "^10.0.2",
    "@langchain/core": "^1.2.17",
    "@langchain/google": "^0.2.10",
    "@langchain/langgraph": "^1.4.21",
    "@moneo/ui": "*",
    "@vercel/sandbox": "^3.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
