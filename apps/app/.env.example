# Copy to .env.local. Empty values switch that feature off.

APP_ENVIRONMENT=development

# Local Postgres from docker-compose.yml. Vercel + Neon inject DATABASE_URL for you.
DATABASE_URL=postgres://moneo:moneo@localhost:5436/moneo
# Hostname of the production Neon endpoint. Previews refuse to migrate when they point at it.
APP_PRODUCTION_DB_HOST=

# Clerk. Leave both empty locally and Clerk runs in keyless mode with throwaway dev keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Gemini on Vertex AI. An empty project turns off the assistant and every AI helper.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Service account key JSON on one line. Empty uses `gcloud auth application-default login` instead.
APP_GOOGLE_CREDENTIALS_JSON=
APP_AI_MODEL=gemini-3.6-flash
APP_AI_HOURLY_LIMIT=60

# Charts, reports and widgets in the assistant. Needs the assistant on, APP_SANDBOX=on and all four R2 values.
# Scripts run in a Vercel Sandbox, which signs in with VERCEL_OIDC_TOKEN (`vercel env pull` locally, automatic on Vercel).
APP_SANDBOX=
APP_SANDBOX_HOURLY_LIMIT=20
APP_R2_ACCOUNT_ID=
APP_R2_ACCESS_KEY_ID=
APP_R2_SECRET_ACCESS_KEY=
APP_R2_BUCKET=moneo

APP_SITE_URL=http://localhost:3030
APP_WEB_URL=http://localhost:3031
