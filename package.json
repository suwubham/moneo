{
  "name": "moneo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "./dev.sh",
    "dev:site": "npm run dev -w @moneo/site",
    "dev:app": "npm run dev -w @moneo/app",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @moneo/app",
    "db:migrate": "npm run db:migrate -w @moneo/app",
    "db:studio": "npm run db:studio -w @moneo/app"
  },
  "engines": {
    "node": ">=22"
  }
}
